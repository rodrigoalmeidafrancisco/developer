{
  "AllowedHosts": "*",
  "Application": {
    "_Build": "00000000.0",
    "_Environment": "DEVELOP",
    "_Release": "Release-0",
    "Name": "Developer",
    "Policys": [
      {
        "Name": "PolicyDeveloper",
        "Scopes": [ "Developer.API" ]
      }
    ],
    "Type": "WebApi",
    "WebUri": "https://localhost:7244"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=Developer;Integrated Security=True;MultipleActiveResultSets=true;Connect Timeout=60;TrustServerCertificate=true;Encrypt=False;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Parameters": {
    "KeyToken": "your-key-token-here",
    "Proxy": {
      "ByPass": ".exemplo.com.br|.exemplo.intranet",
      "Enable": "false",
      "Porta": "8080",
      "Url": "http://exemplo.intranet"
    }
  },
  "Services": {
  }
}